{
	"bracketSpacing": true,
	"semi": true,
	"singleQuote": true,
	"tabWidth": 4,
	"trailingComma": "all",
	"useTabs": true,
	"printWidth": 100,
	"arrowParens": "always",
	"endOfLine": "lf",
	"htmlWhitespaceSensitivity": "css",
	"singleAttributePerLine": false,
	"bracketSameLine": false,
	"jsxSingleQuote": false,
	"proseWrap": "preserve",
	"quoteProps": "as-needed",
	"embeddedLanguageFormatting": "auto",
	"experimentalOperatorPosition": "end"
}
